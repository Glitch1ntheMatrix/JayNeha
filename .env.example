# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side secret used to sign guest/admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Shared password for the Hosts' view (admin panel). Never exposed to the browser.
ADMIN_PASSWORD=nehajay2026

# The wedding RSVP deadline shown to guests (free text, matches the original design)
RSVP_DEADLINE="30 September 2026"

# Whether the "Your stay at Ikshana Resort" section can appear at all
# (per-guest visibility is still controlled by whether a room number is set)
NEXT_PUBLIC_SHOW_ROOM_SECTION=true
